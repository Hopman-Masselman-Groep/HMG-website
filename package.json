{
	"name": "hmg-website",
	"version": "1.0.0",
	"description": "Website van de Scouting Hopman Masselman Groep uit Soest",
	"scripts": {
		"start": "run-p start:*",
		"start:eleventy": "eleventy --serve",
		"start:postcss": "postcss src/styles/*.css --dir public --watch",
		"build": "rimraf public && cross-env ELEVENTY_PRODUCTION=true eleventy && cross-env NODE_ENV=production postcss src/styles/*.css --dir public"
	},
	"keywords": [
		"Website",
		"SSG"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Hopman-Masselman-Groep/HMG-website"
	},
	"author": "Maartn",
	"license": "Apache-2.0",
	"type": "module",
	"dependencies": {
		"@11ty/eleventy": "^3.0.0",
		"@11ty/eleventy-navigation": "^1.0.5",
		"@tailwindcss/postcss": "^4.0.9",
		"@tailwindcss/typography": "^0.5.16",
		"cross-env": "^7.0.3",
		"cssnano": "^7.0.6",
		"daisyui": "^5.0.0",
		"eleventy-plugin-embed-everything": "^1.21.2",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.5.3",
		"postcss-cli": "^11.0.0",
		"rimraf": "^6.0.1",
		"tailwindcss": "^4.0.9"
	}
}
